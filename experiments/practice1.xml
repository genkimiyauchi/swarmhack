<?xml version="1.0" ?>
<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment 
                ticks_per_second="10"
                random_seed="10005" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers>

    <!-- Controller 1 -->
    <robot_controller>
      <params>
        <wheel_turning hard_turn_angle_threshold="90"
                  soft_turn_angle_threshold="90"
                  no_turn_angle_threshold="10"
                  max_speed="0.1" />
        <flocking target_distance_walk="0.2"
                  target_distance_target="0.08"
                  gain="100"
                  exponent="2" />
        <!-- <blocking target_distance="20"
                  gain="1000"
                  exponent="6" /> -->
        <target_tracking target_angle="0"
                  kp="10"
                  ki="0"
                  kd="0" 
                  thres_range="0.05" />
        <!-- Parameters for motion                                                    -->
        <!--   type = {"direct", "angle_drift", "wheel_drift"}                        -->
        <!--   random_walk_rotation_angle (degrees) = "[0:inf],[0:inf]" (e.g. "0,90") -->
        <!--   broadcast_duration (seconds) = "[0:inf]" (e.g. "7.5")                  -->
        <motion type="direct"
                random_walk_rotation_angle="15,90"
                broadcast_duration="8" />
      </params>
    </robot_controller>

  </controllers>

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena>
    
    <target position="0,0,0" radius="0.25" />
    
    <e-puck id="1" position="0.5,0.5,0" orientation="0,0,0" />
    <e-puck id="20" position="0.6,0.6,0" orientation="0,0,0" />

  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <range_and_bearing id="rab" check_occlusions="false"/>
    <led id="leds" />
  </media>

  <!-- ****************** -->
  <!-- * Visualization * -->
  <!-- ****************** -->
  <visualization>
    <webviz>
      <user_functions library="build/loop_functions/target_tracking_loop_functions/libtarget_tracking_loop_functions" 
                      label="target_tracking_webviz_user_functions" />
    </webviz>
  </visualization>

</argos-configuration>